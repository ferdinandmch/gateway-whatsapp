# ---------------------------------------------------------------------------
# Application
# ---------------------------------------------------------------------------

# Execution environment: development | staging | production
APP_ENV=development

# Port the backend listens on
APP_PORT=8000

# Logging level: DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO

# Default HTTP timeout for outgoing requests (seconds)
HTTP_TIMEOUT=30

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------

# PostgreSQL async connection string (must use postgresql+asyncpg:// driver)
DATABASE_URL=postgresql+asyncpg://postgres:postgres@localhost:5432/whatsapp_gateway

# ---------------------------------------------------------------------------
# Redis
# ---------------------------------------------------------------------------

# Redis connection string (provisioned in V1, not actively used yet)
REDIS_URL=redis://localhost:6379/0

# ---------------------------------------------------------------------------
# Evolution API (WhatsApp provider)
# ---------------------------------------------------------------------------

# Base URL of the Evolution API service
EVOLUTION_API_URL=http://localhost:8080

# Global API key for the Evolution API
EVOLUTION_API_KEY=your-evolution-api-key-here

# ---------------------------------------------------------------------------
# Security
# ---------------------------------------------------------------------------

# Secret used to validate incoming webhooks from Evolution API (X-Webhook-Secret)
WEBHOOK_SECRET=your-webhook-secret-here

# Salt used when hashing client API keys before storage
API_KEY_SALT=your-api-key-salt-here

# Admin token for the POST /v1/clients endpoint (X-Admin-Token header)
ADMIN_TOKEN=your-admin-token-here

# ---------------------------------------------------------------------------
# n8n integration
# ---------------------------------------------------------------------------

# Default webhook URL to forward normalized events to n8n
N8N_DEFAULT_WEBHOOK_URL=http://localhost:5678/webhook/default

# Timeout in seconds for n8n webhook forwarding calls (default: 5)
N8N_FORWARD_TIMEOUT=5

# ---------------------------------------------------------------------------
# Webhook base URL
# ---------------------------------------------------------------------------

# Base URL used to construct per-instance webhook URLs for the Evolution API
# In Docker Compose environments, use host.docker.internal to reach the backend
WEBHOOK_BASE_URL=http://host.docker.internal:8000
